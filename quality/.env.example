# Copy to quality/.env (ignored). Tools are outside the Git checkout.
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_HOME=C:/custom/bins/sonarqube/sonarqube-26.9.0.129388
SONAR_JAVA_HOME=C:/custom/bins/jdk/jdk-21.0.12.1+1
SONAR_SCANNER_HOME=C:/custom/bins/sonar-scanner/sonar-scanner-8.1.0.6389
SONAR_USER_HOME=C:/custom/bins/sonar-cache
# Project analysis token, generated in SonarQube > My Account > Security.
SONAR_TOKEN=
# Optional read-capable user token for evidence export (including security hotspots).
SONAR_REPORT_TOKEN=
# Enable only for a short local demonstration on a disk below Sonar's free-space recommendation.
SONAR_LOW_DISK_DEMO=false
