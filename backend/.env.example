# Local only. Never commit real credentials.
DB_URL=jdbc:postgresql://YOUR-POOLER-HOST/neondb?sslmode=require&channelBinding=require
DB_MIGRATION_URL=jdbc:postgresql://YOUR-DIRECT-HOST/neondb?sslmode=require&channelBinding=require
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
SPRING_PROFILES_ACTIVE=dev

# Optional live AI. Offline mode works without a key.
AI_PROVIDER=mock
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=12
# Local Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434/v1,
# AI_MODEL=YOUR_INSTALLED_MODEL. AI_API_KEY may stay empty.

# For registered accounts only, set DEMO_ENABLED=false.
# Production requires DEMO_ENABLED=false and HTTPS cookies (default secure=true).
# APP_ORIGINS=https://YOUR_APP_HOST
# AUTH_COOKIE_SECURE=true
