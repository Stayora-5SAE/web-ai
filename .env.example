# Copy to .env in the repository root. Never commit real credentials.

# Application database and runtime
DB_URL=jdbc:postgresql://YOUR-POOLER-HOST/neondb?sslmode=require&channelBinding=require
DB_MIGRATION_URL=jdbc:postgresql://YOUR-DIRECT-HOST/neondb?sslmode=require&channelBinding=require
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
SPRING_PROFILES_ACTIVE=dev

# Optional live AI. Offline mode works without a key.
AI_PROVIDER=mock
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=12
# Local Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434/v1,
# AI_MODEL=YOUR_INSTALLED_MODEL. AI_API_KEY may stay empty.

# For registered accounts only, set DEMO_ENABLED=false.
# Production requires DEMO_ENABLED=false and HTTPS cookies (default secure=true).
# APP_ORIGINS=https://YOUR_APP_HOST
# AUTH_COOKIE_SECURE=true

# Optional local SonarQube workflow. Tools are outside the Git checkout.
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_HOME=C:/custom/bins/sonarqube/sonarqube-26.9.0.129388
SONAR_JAVA_HOME=C:/custom/bins/jdk/jdk-21.0.12.1+1
SONAR_SCANNER_HOME=C:/custom/bins/sonar-scanner/sonar-scanner-8.1.0.6389
SONAR_USER_HOME=C:/custom/bins/sonar-cache
# Project analysis token, generated in SonarQube > My Account > Security.
SONAR_TOKEN=
# Optional read-capable user token for evidence export (including security hotspots).
SONAR_REPORT_TOKEN=
# Enable only for a short local demonstration on a disk below Sonar's free-space recommendation.
SONAR_LOW_DISK_DEMO=false
